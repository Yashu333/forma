generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Group {
  id                 String   @id @default(cuid())
  name               String
  color              String   @default("#F97316")
  ownerId            String
  order              Float    @default(0)
  createdAt          DateTime @default(now())
  excludeFromReports Boolean  @default(false)
  statuses           Status[]
  tasks              Task[]
}

model Status {
  id        String  @id @default(cuid())
  name      String
  groupId   String
  order     Float   @default(0)
  celebrate Boolean @default(false)
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tasks     Task[]
}

model Task {
  id           String      @id @default(cuid())
  title        String
  description  String?
  groupId      String
  statusId     String
  priority     Priority    @default(MEDIUM)
  order        Float       @default(0)
  parentTaskId String?
  createdBy    String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  dueDate      DateTime?
  deletedAt    DateTime?
  archivedAt   DateTime?
  completedAt  DateTime?
  abcde        Abcde?
  abcdeRank    Int? // A-1, A-2… ordering within a letter; null = unranked
  plannedFor   String? // local date "YYYY-MM-DD" this task is planned for; null = backlog
  repeat         Json?   // RepeatRule (lib/recurrence/rule.ts); null = doesn't repeat
  seriesId       String? // id of the first task in a repeating series; same on every instance
  nextInstanceId String? // set on a completed instance once its successor exists (stops duplicates)
  scheduledAt    DateTime? // time block: when the user plans to work on it; null = not blocked
  blockMinutes   Int?      // length of the time block in minutes; null = the 60 minute default
  group        Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  status       Status      @relation(fields: [statusId], references: [id])
  parent       Task?       @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]      @relation("Subtasks")
  comments     Comment[]
  activity     Activity[]
  frogPlans    DailyPlan[]
  focusSessions FocusSession[]

  @@index([seriesId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  focusMins             Int      @default(25)
  shortMins             Int      @default(5)
  longMins              Int      @default(15)
  sessionsBeforeLong    Int      @default(4)
  autoStartBreaks       Boolean  @default(false)
  autoStartFocus        Boolean  @default(false)
  spotifyAccessToken    String?
  spotifyRefreshToken   String?
  spotifyTokenExpiresAt DateTime?
  frogFirstMode         Boolean  @default(false)
}

enum Priority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum Abcde {
  A
  B
  C
  D
  E
}

model DailyPlan {
  id         String    @id @default(cuid())
  userId     String
  date       String    // local date "YYYY-MM-DD"
  frogTaskId String?
  plannedAt  DateTime? // set when the morning "Plan my day" flow is saved
  reviewedAt DateTime? // set when the evening "Close the day" flow is saved
  wentWell   String?
  improve    String?
  rating     Int?      // 1–5, "how did today go?"
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  frogTask   Task?     @relation(fields: [frogTaskId], references: [id], onDelete: SetNull)

  @@unique([userId, date])
  @@index([userId, date])
}

// The rough sheet on Today: a free-text brain dump for one local day, plus the
// morning check-in (how you feel, how sure you are of finishing the list).
model DailyNote {
  id         String   @id @default(cuid())
  userId     String
  date       String   // local date "YYYY-MM-DD"
  body       String   @default("")
  mood       Int?     // 1 low, 2 okay, 3 good, 4 great
  confidence Int?     // finish today's list? 1 not really, 2 maybe, 3 yes
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, date])
}

model FocusSession {
  id          String   @id @default(cuid())
  userId      String
  taskId      String?
  startedAt   DateTime
  endedAt     DateTime
  durationSec Int
  completed   Boolean // ran to zero (true) vs skipped or reset early (false)
  createdAt   DateTime @default(now())
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([taskId])
}

model Habit {
  id         String       @id @default(cuid())
  userId     String
  name       String
  weekdays   Int[]        @default([0, 1, 2, 3, 4, 5, 6]) // days it is scheduled; 0 = Sunday
  order      Float        @default(0)
  archivedAt DateTime?
  createdAt  DateTime     @default(now())
  checks     HabitCheck[]

  @@index([userId])
}

model HabitCheck {
  id        String   @id @default(cuid())
  habitId   String
  date      String // local date "YYYY-MM-DD"
  createdAt DateTime @default(now())
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}

model WeeklyReview {
  id         String    @id @default(cuid())
  userId     String
  weekStart  String // the Monday, "YYYY-MM-DD"
  win        String? // biggest win
  obstacle   String? // what got in the way
  focus      String? // one focus for next week
  rating     Int? // 1-5
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, weekStart])
}
