generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Group {
  id                 String   @id @default(cuid())
  name               String
  color              String   @default("#F97316")
  ownerId            String
  order              Float    @default(0)
  createdAt          DateTime @default(now())
  excludeFromReports Boolean  @default(false)
  statuses           Status[]
  tasks              Task[]
}

model Status {
  id        String  @id @default(cuid())
  name      String
  groupId   String
  order     Float   @default(0)
  celebrate Boolean @default(false)
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tasks     Task[]
}

model Task {
  id           String      @id @default(cuid())
  title        String
  description  String?
  groupId      String
  statusId     String
  priority     Priority    @default(MEDIUM)
  order        Float       @default(0)
  parentTaskId String?
  createdBy    String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  dueDate      DateTime?
  deletedAt    DateTime?
  archivedAt   DateTime?
  completedAt  DateTime?
  abcde        Abcde?
  abcdeRank    Int? // A-1, A-2… ordering within a letter; null = unranked
  plannedFor   String? // local date "YYYY-MM-DD" this task is planned for; null = backlog
  group        Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  status       Status      @relation(fields: [statusId], references: [id])
  parent       Task?       @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]      @relation("Subtasks")
  comments     Comment[]
  activity     Activity[]
  frogPlans    DailyPlan[]
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  focusMins             Int      @default(25)
  shortMins             Int      @default(5)
  longMins              Int      @default(15)
  sessionsBeforeLong    Int      @default(4)
  autoStartBreaks       Boolean  @default(false)
  autoStartFocus        Boolean  @default(false)
  spotifyAccessToken    String?
  spotifyRefreshToken   String?
  spotifyTokenExpiresAt DateTime?
}

enum Priority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum Abcde {
  A
  B
  C
  D
  E
}

model DailyPlan {
  id         String    @id @default(cuid())
  userId     String
  date       String    // local date "YYYY-MM-DD"
  frogTaskId String?
  plannedAt  DateTime? // set when the morning "Plan my day" flow is saved
  reviewedAt DateTime? // set when the evening "Close the day" flow is saved
  wentWell   String?
  improve    String?
  rating     Int?      // 1–5, "how did today go?"
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  frogTask   Task?     @relation(fields: [frogTaskId], references: [id], onDelete: SetNull)

  @@unique([userId, date])
  @@index([userId, date])
}
